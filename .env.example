##############################################################################
# Amazon Market Research Pro - environment reference
#
# Copy to .env for local development:   cp .env.example .env
# .env is gitignored. Never commit real values.
#
# Each variable is marked:
#   PUBLIC  ships to browsers by design; safe in the extension bundle and the
#           admin dashboard, safe to commit
#   SECRET  grants privilege; lives only in an Edge Function secret or your
#           own shell. Never in a client file, never committed, never in a
#           screenshot or a support ticket
##############################################################################


# -----------------------------------------------------------------------------
# PUBLIC - the only two values the clients are allowed to carry
# -----------------------------------------------------------------------------

# PUBLIC. Your project's API URL.
# Appears in: extension/config.js, admin/config.js
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# PUBLIC. The anon key. A JWT whose only claim is "unauthenticated".
#
# It is meant to be published: Supabase ships it to browsers by design. It
# opens no table (RLS denies the anon role on every one) and no Edge Function
# (each verifies a real user JWT first). Finding it in the extension bundle is
# expected, not a breach.
#
# Appears in: extension/config.js, admin/config.js
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# -----------------------------------------------------------------------------
# SECRET - Edge Function environment only
# -----------------------------------------------------------------------------

# SECRET. The service role key. Bypasses Row Level Security on every table.
#
# This is the one credential that matters. Anyone holding it can read every
# profile, rewrite quotas, and dump usage history. It exists in exactly one
# place: the Edge Function environment, where Supabase injects it
# automatically. You do not need to set it by hand for a normal deployment.
#
# Set it locally ONLY if you are running `supabase functions serve`:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#
# If it ever leaks, rotate it immediately:
#   Dashboard -> Project Settings -> API -> service_role -> Reset
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# CONFIGURATION - not secret, but wrong values break access
# -----------------------------------------------------------------------------

# Comma-separated CORS allowlist. No wildcards; an empty value fails closed and
# blocks everything, which is deliberate.
#
# Resolution order in the Edge Functions:
#   1. this secret, when set
#   2. app_settings.allowed_origins, when it is not
#
# The database fallback lets you add an origin from the admin console without a
# redeploy, which matters when an extension rebuild changes its ID. Set this
# secret when you want the allowlist frozen at deploy time instead.
#
# The extension ID below is the one pinned by the `key` in
# extension/manifest.json, so it is stable across machines and reloads.
#
#   supabase secrets set ALLOWED_ORIGINS="chrome-extension://mmekjhdfdgcbnphlbpbmkfjiibcfocpk"
#
# Use the literal token __no_origin__ to allow requests that send no Origin
# header at all (curl, server-to-server). Leave it out unless you need it.
ALLOWED_ORIGINS=chrome-extension://mmekjhdfdgcbnphlbpbmkfjiibcfocpk,http://localhost:5173


# -----------------------------------------------------------------------------
# LOCAL TOOLING - your shell only, never deployed
# -----------------------------------------------------------------------------

# SECRET. Supabase CLI personal access token, for `supabase link` and
# `supabase functions deploy`. Tied to your account, not the project.
# Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Your project ref (the subdomain in SUPABASE_URL). Not secret.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
