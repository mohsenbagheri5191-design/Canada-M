{
  "manifest_version": 3,
  "name": "Amazon Market Research Pro V25.1 Complete Data Fix",
  "version": "25.1.5",
  "description": "Deep Search, HTML-based market share intelligence, and restored V23 My Products portfolio.",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.amazon.ca/*",
    "https://www.amazon.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "sandbox": {
    "pages": [
      "brand-dashboard.html"
    ]
  }
}