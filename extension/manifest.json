{
  "manifest_version": 3,
  "name": "Amazon Market Research Pro",
  "version": "30.0.0",
  "description": "Invite-only Amazon seller and agency research. Deep Search, brand market share intelligence, and portfolio tracking.",

  "key": "",

  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "offscreen"
  ],

  "host_permissions": [
    "https://www.amazon.ca/*",
    "https://www.amazon.com/*",
    "https://ftwkxuqqnbtuegabxxnj.supabase.co/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "sandbox": {
    "pages": ["brand-dashboard.html"]
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline'; child-src 'self'"
  }
}
