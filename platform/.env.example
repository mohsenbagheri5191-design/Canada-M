# Platform environment
#
# Copy to .env and fill in. .env is gitignored at the repository root.

# --- Safe in client code -----------------------------------------------------
# The publishable key authenticates nothing on its own. Every table has RLS, so
# what a caller may read is decided by the JWT they present.
SUPABASE_URL=https://sxsbeavdmfuznigslfnp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_BALtodXYHyXJ41amq26zhA_17o7gMTI

# --- Never in client code, never committed -----------------------------------
# The service role key bypasses RLS on every table. It belongs in an Edge
# Function secret. If it ever reaches a browser bundle, every tenant's data is
# readable by anyone who opens dev tools.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for migrations and platform/supabase/tests/verify.sql.
# Supabase dashboard -> Project Settings -> Database -> Connection string.
DATABASE_URL=
